# Copy this file to .env. Never commit .env.
DASHSCOPE_API_KEY=
ALIYUN_WORKSPACE_ID=
ALIYUN_REGION=cn-beijing
OMNI_MODEL=qwen3.5-omni-flash-realtime
TEXT_CHAT_MODEL=qwen3.7-plus
JUDGMENT_MODEL=qwen3.7-plus
TTS_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
CONNECTION_TIMEOUT_SECONDS=20
RESPONSE_TIMEOUT_SECONDS=90

# Tencent Cloud server-side voiceprint credentials. Never expose these in browser code.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_VOICEPRINT_REGION=ap-guangzhou
TENCENT_VOICEPRINT_MINIMUM_SCORE=70
TENCENT_VOICEPRINT_TIMEOUT_SECONDS=15

# Optional server-side fallback. Families do not enter this value in the page.
BROWSER_CAPTURE_ACCESS_TOKEN=

# Required for a public researcher console. Use a separate random value (12+ characters).
RESEARCH_CONSOLE_ACCESS_TOKEN=

# Paths may be relative here. The application resolves them to absolute paths
# from the project root before any file operation.
INPUT_DIR=data/input
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
LOG_DIR=data/logs
