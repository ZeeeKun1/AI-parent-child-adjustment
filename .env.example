# Copy this file to .env. Never commit .env.
DASHSCOPE_API_KEY=
ALIYUN_WORKSPACE_ID=
ALIYUN_REGION=cn-beijing
OMNI_MODEL=qwen3.5-omni-flash-realtime
TTS_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
CONNECTION_TIMEOUT_SECONDS=20
RESPONSE_TIMEOUT_SECONDS=90

# Required when web-live listens beyond localhost. Use a long random invitation code.
BROWSER_CAPTURE_ACCESS_TOKEN=

# Paths may be relative here. The application resolves them to absolute paths
# from the project root before any file operation.
INPUT_DIR=data/input
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
LOG_DIR=data/logs
